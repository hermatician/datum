// datum keymap — Gallium columnar stagger
// ZMK firmware for Nice!nano V2 + Cradio shield

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE  0
#define NAV   1
#define SYM   2
#define FN    3
#define MEDIA 4

&mt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    require-prior-idle-ms = <150>;
};

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    require-prior-idle-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        sqt_ae: sqt_ae {
            compatible = "zmk,behavior-hold-tap";
            label = "SQT_AE";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&ae>, <&kp>;
        };

        semi_oe: semi_oe {
            compatible = "zmk,behavior-hold-tap";
            label = "SEMI_OE";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&oe>, <&kp>;
        };

        dot_aa: dot_aa {
            compatible = "zmk,behavior-hold-tap";
            label = "DOT_AA";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&aa>, <&kp>;
        };
    };

    macros {
        ae: ae {
            compatible = "zmk,behavior-macro";
            label = "AE";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U>
                , <&macro_release &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp E &kp N6 &kp RET>
                ;
        };

        oe: oe {
            compatible = "zmk,behavior-macro";
            label = "OE";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U>
                , <&macro_release &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp F &kp N8 &kp RET>
                ;
        };

        aa: aa {
            compatible = "zmk,behavior-macro";
            label = "AA";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U>
                , <&macro_release &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp E &kp N5 &kp RET>
                ;
        };

        double_colon: double_colon {
            compatible = "zmk,behavior-macro";
            label = "DOUBLE_COLON";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp COLON>;
        };

        arrow: arrow {
            compatible = "zmk,behavior-macro";
            label = "ARROW";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
        };

        fat_arrow: fat_arrow {
            compatible = "zmk,behavior-macro";
            label = "FAT_ARROW";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_double_colon {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&double_colon>;
        };

        combo_arrow {
            timeout-ms = <50>;
            key-positions = <26 27>;
            bindings = <&arrow>;
        };

        combo_fat_arrow {
            timeout-ms = <50>;
            key-positions = <27 28>;
            bindings = <&fat_arrow>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // BASE — Gallium columnar stagger
        // b  l  d  c  v  |  j  y  o  u  ,
        // n  r  t  s  g  |  p  h  a  e  i
        // x  q  m  w  z  |  k  f  '  ;  .
        //       DEL SPC   |  BSPC ENTER
        base_layer {
            label = "BASE";
            bindings = <
                &kp B        &kp L        &kp D        &kp C        &kp V         &kp J          &kp Y          &kp O          &kp U          &kp COMMA
                &hm LGUI N   &hm LALT R   &hm LSHFT T  &hm LCTRL S  &kp G         &kp P          &hm RCTRL H    &hm RSHFT A    &hm RALT E     &hm RGUI I
                &kp X        &kp Q        &kp M        &kp W        &kp Z         &kp K          &kp F          &sqt_ae 0 SQT  &semi_oe 0 SEMI &dot_aa 0 DOT
                                                       &lt SYM DEL  &lt NAV SPACE &lt FN BSPC    &lt MEDIA RET
            >;
        };

        // NAV — Navigation + Numbers
        nav_layer {
            label = "NAV";
            bindings = <
                &kp N1   &kp N2    &kp N3   &kp N4   &kp N5        &kp N6    &kp N7    &kp N8     &kp N9     &kp N0
                &kp TAB  &kp HOME  &kp UP   &kp END  &kp PG_UP     &kp BSPC  &kp LEFT  &kp DOWN   &kp RIGHT  &kp DEL
                &kp ESC  &trans    &trans   &trans   &kp PG_DN     &trans    &trans    &trans     &trans     &kp RET
                                            &trans   &trans        &lt FN BSPC &trans
            >;
        };

        // SYM — Symbols
        sym_layer {
            label = "SYM";
            bindings = <
                &kp EXCL   &kp AT    &kp HASH  &kp DLLR  &kp PRCNT     &kp CARET     &kp AMPS  &kp ASTRK  &kp LPAR   &kp RPAR
                &kp GRAVE  &kp MINUS &kp EQUAL &kp LBKT  &kp LBRC      &kp RBRC      &kp RBKT  &kp PLUS   &kp UNDER  &kp SEMI
                &kp TILDE  &kp PIPE  &kp BSLH  &kp LT    &kp GT        &double_colon &kp DQT   &kp SQT    &kp COLON  &kp QMARK
                                               &trans    &lt FN SPACE  &trans        &trans
            >;
        };

        // FN — Function + System
        fn_layer {
            label = "FN";
            bindings = <
                &kp F1      &kp F2   &kp F3  &kp F4  &kp F5        &kp F6  &kp F7      &kp F8       &kp F9       &kp F10
                &kp F11     &kp F12  &trans  &trans  &kp CAPS      &trans  &kp C_MUTE  &kp C_VOL_DN &kp C_VOL_UP &trans
                &bootloader &trans   &trans  &trans  &trans        &trans  &trans      &trans       &trans       &trans
                                             &trans  &trans        &trans  &trans
            >;
        };

        // MEDIA — Media controls
        media_layer {
            label = "MEDIA";
            bindings = <
                &trans  &trans      &trans    &trans      &trans        &trans  &trans      &trans       &trans       &trans
                &trans  &kp C_PREV  &kp C_PP  &kp C_NEXT  &trans        &trans  &trans      &trans       &trans       &trans
                &trans  &trans      &trans    &trans      &trans        &trans  &kp C_MUTE  &kp C_VOL_DN &kp C_VOL_UP &trans
                                              &trans      &trans        &trans  &trans
            >;
        };
    };
};
