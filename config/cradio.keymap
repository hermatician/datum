/*
 * datum keymap
 * QWERTY + Danish OS layout
 * ZMK firmware for Nice!nano V2 + Cradio shield
 *
 * Base layer is standard Danish QWERTY with æøå on first layer
 * OS keyboard layout must be set to Danish
 *
 * Danish character keycodes (Danish OS):
 *   å = ]
 *   æ = ;
 *   ø = '
 *
 * Thumb cluster:
 *   esc/SYM  spc/NAV  |  bspc/EXT  ent/MEDIA
 *
 * Combos:
 *   esc+spc = SETTINGS
 *   spc+bspc = FN
 *   bspc+ent = ACCENT (not needed anymore but kept for future use)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE     0
#define NAV      1
#define SYM      2
#define EXT      3
#define FN       4
#define MEDIA    5
#define SETTINGS 6

&mt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    require-prior-idle-ms = <150>;
};

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    require-prior-idle-ms = <150>;
};

&sk {
    ignore-modifiers;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        unstick: unstick {
            compatible = "zmk,behavior-macro";
            label = "ZM_unstick";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT &kp RSHIFT &kp LCTRL &kp RCTRL &kp LALT &kp RALT &kp LGUI &kp RGUI>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_settings {
            timeout-ms = <300>;
            key-positions = <30 31>;
            bindings = <&mo SETTINGS>;
        };

        combo_fn {
            timeout-ms = <200>;
            key-positions = <31 32>;
            bindings = <&mo FN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // BASE — Danish QWERTY
        //
        // q  w  e  r  t  |  y  u  i  o  p
        // a  s  d  f  g  |  h  j  k  l  å
        // z  x  c  v  b  |  n  m  æ  ø  ,
        //       esc spc   |  bspc ent
        //
        // Home row mods:
        //   s=GUI d=ALT f=SHIFT g=CTRL | h=CTRL j=SHIFT k=ALT l=GUI
        base_layer {
            label = "BASE";
            bindings = <
                &kp Q        &kp W        &kp E        &kp R        &kp T         &kp Y        &kp U        &kp I        &kp O        &kp P
                &kp A        &hm LGUI S   &hm LALT D   &hm LSHFT F  &hm LCTRL G   &hm RCTRL H  &hm RSHFT J  &hm RALT K   &hm RGUI L   &kp LBKT
                &kp Z        &kp X        &kp C        &kp V        &kp B         &kp N        &kp M        &kp SEMI     &kp SQT      &kp COMMA
                                                       &lt SYM ESC  &lt NAV SPACE &lt EXT BSPC &lt MEDIA RET
            >;
        };

        // NAV — Navigation + Numbers
        nav_layer {
            label = "NAV";
            bindings = <
                &kp N1   &kp N2    &kp N3   &kp N4   &kp N5        &kp N6    &kp N7    &kp N8     &kp N9     &kp N0
                &kp TAB  &kp HOME  &kp UP   &kp END  &kp PG_UP     &kp BSPC  &kp LEFT  &kp DOWN   &kp RIGHT  &kp DEL
                &kp ESC  &trans    &trans   &trans   &kp PG_DN     &trans    &trans    &trans     &trans     &kp RET
                                            &trans   &trans        &trans    &trans
            >;
        };

        // SYM — Symbols
        // Note: some keycodes adjusted for Danish OS layout
        sym_layer {
            label = "SYM";
            bindings = <
                &kp EXCL   &kp AT    &kp HASH  &kp DLLR  &kp PRCNT     &kp CARET  &kp AMPS  &kp STAR   &kp LPAR   &kp RPAR
                &kp GRAVE  &kp MINUS &kp EQUAL &kp LBKT  &kp LBRC      &kp RBRC   &kp LBKT  &kp PLUS   &kp UNDER  &kp PIPE
                &kp TILDE  &kp BSLH  &kp LT    &kp GT    &kp FSLH      &kp QMARK  &kp DQT   &kp COLON  &kp SEMI   &kp DOT
                                               &trans    &trans        &trans     &trans
            >;
        };

        // EXT — Extended navigation + modifiers
        ext_layer {
            label = "EXT";
            bindings = <
                &kp ESC   &trans    &trans     &trans     &trans        &kp PG_UP  &kp HOME  &kp UP    &kp END    &kp CAPS
                &sk LALT  &sk LGUI  &sk LSHFT  &sk LCTRL  &kp RALT      &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL
                &trans    &trans    &trans     &kp TAB    &trans        &trans     &kp BSPC  &trans    &trans     &trans
                                               &trans     &kp LCTRL    &trans     &trans
            >;
        };

        // FN — Function keys (combo: spc+bspc)
        fn_layer {
            label = "FN";
            bindings = <
                &kp F1   &kp F2   &kp F3  &kp F4  &kp F5        &kp F6  &kp F7      &kp F8       &kp F9       &kp F10
                &kp F11  &kp F12  &trans  &trans  &kp CAPS      &trans  &kp C_MUTE  &kp C_VOL_DN &kp C_VOL_UP &trans
                &trans   &trans   &trans  &trans  &trans        &trans  &trans      &trans       &trans       &trans
                                          &trans  &trans        &trans  &trans
            >;
        };

        // MEDIA — Media controls (hold ent)
        media_layer {
            label = "MEDIA";
            bindings = <
                &trans  &trans      &trans    &trans      &trans        &trans  &trans      &trans       &trans       &trans
                &trans  &kp C_PREV  &kp C_PP  &kp C_NEXT  &trans        &trans  &trans      &trans       &trans       &trans
                &trans  &trans      &trans    &trans      &trans        &trans  &kp C_MUTE  &kp C_VOL_DN &kp C_VOL_UP &trans
                                              &trans      &trans        &trans  &trans
            >;
        };

        // SETTINGS — Bluetooth (combo: esc+spc)
        settings_layer {
            label = "SETTINGS";
            bindings = <
                &bootloader  &trans  &trans  &bt BT_CLR  &bt BT_SEL 0        &bt BT_SEL 3  &trans    &unstick  &trans  &bootloader
                &trans       &trans  &trans  &trans      &bt BT_SEL 1        &bt BT_SEL 4  &trans    &trans    &trans  &trans
                &trans       &trans  &trans  &trans      &bt BT_SEL 2        &bt BT_SEL 5  &trans    &trans    &trans  &trans
                                             &none       &none               &none         &none
            >;
        };
    };
};
